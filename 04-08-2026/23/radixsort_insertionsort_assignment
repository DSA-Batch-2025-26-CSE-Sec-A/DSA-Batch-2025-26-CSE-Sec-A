#include <stdio.h>

// Insertion Sort based on the current digit
void insertionSort(int arr[], int n, int exp)
{
    int i, j, key;

    for (i = 1; i < n; i++)
    {
        key = arr[i];
        j = i - 1;

        // Compare the digits
        while (j >= 0 &&
               ((arr[j] / exp) % 10) > ((key / exp) % 10))
        {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = key;
    }
}

// Radix Sort
void radixSort(int arr[], int n)
{
    int max = arr[0];
    int i;

    // Find the maximum element
    for (i = 1; i < n; i++)
    {
        if (arr[i] > max)
        {
            max = arr[i];
        }
    }

    // Sort according to each digit
    for (int exp = 1; max / exp > 0; exp *= 10)
    {
        insertionSort(arr, n, exp);
    }
}

int main()
{
    int arr[100], n, i;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    radixSort(arr, n);

    printf("Sorted array: ");
    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
