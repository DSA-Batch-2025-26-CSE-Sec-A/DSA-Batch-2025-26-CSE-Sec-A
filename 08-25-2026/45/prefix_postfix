#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 100

char stack[MAX][MAX];
int top = -1;

void push(char str[])
{
    strcpy(stack[++top], str);
}

void pop(char str[])
{
    strcpy(str, stack[top--]);
}

int main()
{
    char prefix[MAX];
    char op1[MAX], op2[MAX], temp[MAX];
    int i;

    printf("Enter prefix expression: ");
    scanf("%s", prefix);

    // Scan from right to left
    for (i = strlen(prefix) - 1; i >= 0; i--)
    {
        // If operand
        if (isalnum(prefix[i]))
        {
            temp[0] = prefix[i];
            temp[1] = '\0';
            push(temp);
        }

        // If operator
        else
        {
            pop(op1);
            pop(op2);

            // operand1 + operand2 + operator
            sprintf(temp, "%s%s%c",
                    op1, op2, prefix[i]);

            push(temp);
        }
    }

    pop(temp);

    printf("Postfix expression: %s\n", temp);

    return 0;
}
