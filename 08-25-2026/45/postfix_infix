#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 100

char stack[MAX][MAX];
int top = -1;

void push(char str[])
{
    strcpy(stack[++top], str);
}

void pop(char str[])
{
    strcpy(str, stack[top--]);
}

int main()
{
    char postfix[MAX];
    char op1[MAX], op2[MAX], temp[MAX];
    int i;

    printf("Enter postfix expression: ");
    scanf("%s", postfix);

    for (i = 0; postfix[i] != '\0'; i++)
    {
        // If operand
        if (isalnum(postfix[i]))
        {
            temp[0] = postfix[i];
            temp[1] = '\0';
            push(temp);
        }

        // If operator
        else
        {
            pop(op2);
            pop(op1);

            sprintf(temp, "(%s%c%s)", op1, postfix[i], op2);

            push(temp);
        }
    }

    pop(temp);

    printf("Infix expression: %s\n", temp);

    return 0;
}
