#include <stdio.h>
int digitSum(long long n)
{
    if (n < 10)
        return (int)n;
    return (int)(n % 10) + digitSum(n / 10);
}
int digitalRoot(long long n)
{
    int sum;
    if (n < 10)
        return (int)n;
    sum = digitSum(n);
    return digitalRoot(sum);
}
int main()
{
    long long n;
    scanf("%lld", &n);
    printf("%d %d\n", digitSum(n), digitalRoot(n));
    return 0;
}
Sample Input:
98765
Output:
35 8
