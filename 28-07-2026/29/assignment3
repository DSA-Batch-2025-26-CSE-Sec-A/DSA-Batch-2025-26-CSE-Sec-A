#include <stdio.h>

int main() 
{
    int n, i, a;
    
    printf("Enter the number of elements in the array:\n");
    scanf("%d", &n);
    
    int arr[n];
    
    printf("Enter the elements of the array one by one:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    for(i = 0; i < n / 2; i++) 
    {
        a = arr[i];
        arr[i] = arr[n - 1 - i];
        arr[n - 1 - i] = a;
    }
    
    printf("The revised array after reversing: ");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    
    return 0;
}
